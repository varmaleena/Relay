VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-relay-local
VITE_FIREBASE_API_KEY=demo-only-key
VITE_FIREBASE_APP_ID=demo-relay-web
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Emulator mode runs only on loopback, never with a real cloud project.
# App Check has no emulator; backend local-only mode explicitly skips it.
# Deployed use: VITE_AUTH_MODE=firebase and actual Firebase project/app settings.
# VITE_FIREBASE_APPCHECK_SITE_KEY=actual-registered-recaptcha-enterprise-site-key
# Vite variables are browser-visible config, never secrets or credentials.
