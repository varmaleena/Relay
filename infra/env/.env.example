# Relay M0 local foundations. Non-secret configuration only.
# Copy to .env.local (git ignored), then load explicitly with Settings(_env_file=...).
# Settings does not automatically load .env files. No live model call is enabled here.
ENVIRONMENT=local
SERVICE=api
DEMO_MODE=true
GENAI_MODE=fake

# Cloud application configuration stays empty until the corresponding resources exist.
# The approved dev project is work-511514; only the isolated platform smoke is planned.
# Full dev API requires evidence/export buckets, Pub/Sub topic and reasoning model below.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GENAI_LOCATION=
FIRESTORE_DB=(default)

# Populate only with actual discovered and capability-checked Gemini 3.x IDs.
# Never copy a document's illustrative model ID without project availability validation.
MODEL_REASONING=
MODEL_FAST=
MODEL_LIVE=
MODEL_PRO=

BUCKET_EVIDENCE=
BUCKET_EXPORTS=
BUCKET_SOURCES=
BUCKET_EVAL=
PUBSUB_TOPIC_JOBS=
# This is a Secret Manager resource name, never the secret value itself.
HMAC_SECRET_NAME=
ALLOWED_FETCH_DOMAINS=

ALLOWED_ORIGINS=http://localhost:5173
SUPPORTED_LANGUAGES=en,hi
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=Asia/Kolkata
# Operational urgency thresholds; these are not legal deadlines.
URGENT_MINUTES=120
HIGH_HOURS=72
MAX_SESSION_SECONDS=600
# Per-process concurrency only; not a distributed quota or billing cap.
MAX_MODEL_CONCURRENCY=1
GIT_SHA=development
BUILT_AT=unbuilt

# SDK emulator variables are local-only and not Settings fields.
# Clear them in every deployed environment. No emulator connects to a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8095
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PUBSUB_EMULATOR_HOST=127.0.0.1:8086

# Before using ENVIRONMENT=dev:
# - Set GENAI_MODE=live or a disclosed replay mode (fake is local-only).
# - Set GCP_PROJECT_ID, GENAI_LOCATION and an explicit HTTPS ALLOWED_ORIGINS.
# - Supply all Settings.mode_requirements fields for the selected SERVICE.
# - Use workload identity/ADC; never put tokens, private keys or passwords in this file.
# - API needs MODEL_REASONING, BUCKET_EVIDENCE, BUCKET_EXPORTS and PUBSUB_TOPIC_JOBS.
# - live needs MODEL_LIVE, MODEL_FAST and PUBSUB_TOPIC_JOBS.
# - worker needs MODEL_REASONING, MODEL_FAST, evidence/sources/exports and HMAC_SECRET_NAME.
# - a2a needs MODEL_REASONING; eval needs MODEL_REASONING, MODEL_FAST and BUCKET_EVAL.
# - synth needs MODEL_FAST and BUCKET_EVAL; mcp still needs project/location settings.
# The one-off platform smoke Job intentionally uses its own three-variable contract:
# GOOGLE_CLOUD_PROJECT, GENAI_LOCATION and MODEL_FAST; it does not provision app resources.
